<resources>
    <color name="window_background_light">#FFFFFFFF</color>
    <color name="window_background_dark">#FF1C1B1F</color>

    <style name="AppThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
    <!-- TagDrop-specific MaterialComponents theme (Bridge to preserve AppCompat) -->
    <style name="Theme.V2rayNG.TagDrop" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <!-- Use the surface color (keeps material components consistent) -->
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
        
        <!-- Make sure Material components use the Material shapes -->
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        
        <!-- Window/status bar handling for the "liquid glass" look -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        
        <!-- Ensure no action bar for this activity -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
